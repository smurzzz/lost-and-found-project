# ClaimIt environment template.
# Copy to .env and fill values only when the corresponding phase begins.
# Never commit real secrets.

# --- Server (Phase 2+) ---
PORT=3000
NODE_ENV=development

# --- PostgreSQL (Phase 2+) ---
DATABASE_URL=

# --- Supabase (Phase 2+) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Clerk authentication (Phase 2+) ---
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Push notifications (Phase 6) ---
EXPO_ACCESS_TOKEN=
