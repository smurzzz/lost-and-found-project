[TEMPLATE]
# ClaimIt environment template.
# Copy to .env and fill values only when the corresponding phase begins.
# Never commit real secrets.

# --- Server (Phase 2+) ---
PORT=3000
NODE_ENV=development

# --- Mobile app -> API (Phase 2+) ---
# Set this for the app to call the real API; unset = prototype mock mode.
EXPO_PUBLIC_API_URL=http://localhost:3000

# --- Neon PostgreSQL (Phase 2+) ---
# Neon pooled connection string (used by the running app), e.g.
# postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
# Optional: direct (unpooled) endpoint for migrations (Drizzle Kit)
DATABASE_URL_UNPOOLED=

# --- Clerk authentication (Phase 2+) ---
# When CLERK_SECRET_KEY is set the API verifies Clerk JWTs; when absent
# the server accepts dev tokens (dev.<name>.<role>) for local testing.
# Note for the Expo client: the publishable key should also be exposed as
# EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY so @clerk/expo can read it.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Local testing escape hatch: allow dev tokens even with Clerk configured.
# NEVER set to true in production.
ALLOW_DEV_LOGIN=

# --- Push notifications (Phase 6) ---
EXPO_ACCESS_TOKEN=
